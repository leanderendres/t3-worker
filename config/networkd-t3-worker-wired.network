# t3-worker: any wired Ethernet port (including USB adapters such as the
# Realtek RTL8153, named enx<mac>) gets DHCP as soon as a cable is plugged in,
# at boot or later. Its routes (metric 100) win over Wi-Fi (metric 600, set in
# /etc/network/interfaces by setup.sh), so Wi-Fi stays as the fallback.
# Wi-Fi (wl*) is left to ifupdown; Docker/Tailscale links do not match.
[Match]
Type=ether
Name=en* eth*

[Link]
# never delay boot or network-online.target waiting for a cable
RequiredForOnline=no

[Network]
DHCP=yes
IPv6AcceptRA=yes

[DHCPv4]
RouteMetric=100

[IPv6AcceptRA]
RouteMetric=100
